# ============================================================
# .env.azure.example
#   Azure Database for MySQL につなぐときの見本。R-35
#   ★見本に本物のサーバ名を書かない（共有サーバの住所は、他の人も巻き込む）。R-37
#   ★値は絶対に書かない。cp .env.azure.example .env.azure してから手元で入れる。
#
#   使い方（ec/ で）
#     ENV_FILE=.env.azure backend/.venv/Scripts/python scripts/db_check.py
#     （バックエンドを向けるときは .env の DB_* をこの値にする）
# ============================================================
DB_HOST=<your-server>.mysql.database.azure.com
DB_PORT=3306
DB_NAME=ec_koala
DB_USER=
DB_PASSWORD=
# TLS 必須。証明書のパスを指定するなら DB_SSL_CA に置く（空なら既定の検証）
# ★Azure の既定は UTC。接続ごとに JST にする（共有サーバのパラメータは触らない）
DB_TIME_ZONE=+09:00
DB_SSL=1
# ★ポータルから落ちる証明書は DigiCertGlobalRootG2.crt.pem（ec/certs/ に置く。相対パスは ec/ から解く）
DB_SSL_CA=certs/DigiCertGlobalRootG2.crt.pem
