# ============================================================
# .env.example
#   キーの名前だけ書いた見本。★値は絶対に書かない。
#   （設計仕様書 2.3・N-38「秘密をソースに置かない」）
#
#   使い方
#     cp .env.example .env    してから、手元の値を入れる。
#     .env は .gitignore で除外してある（この見本だけを追跡する）。
#
#   本番・検証では、この形の値を App Service のアプリ設定と
#   Key Vault 参照で与える（2.5.1・7.2.3）。ソースには含めない。
# ============================================================

# --- 環境種別（2.3）------------------------------------------
#   local / staging / production
#   ★管理画面からは変更できない。
#   staging のときだけ FT-03・FT-05〜FT-08 の経路が有効（10.2.1）
#   production では /docs と /openapi.json を 404 にする（N-31）
APP_ENV=local

# --- データベース --------------------------------------------
#   手元は docker-compose.yml の MySQL。パスワードは検証用の localonly
#   ★データベース名は ec_koala（共有サーバで 12期の他の人とぶつからないため。R-35）
#   ★TLS：Azure MySQL は必須。DB_SSL=1 で有効、DB_SSL_CA に証明書のパス（空なら既定の検証）
#   ★接続ごとの時刻帯（R-36）。Azure は既定が UTC なので +09:00 にする。空なら触らない
DB_TIME_ZONE=
DB_SSL=0
DB_SSL_CA=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- 画像の置き場（R-10 ③）----------------------------------
#   product_image.url は相対パス（products/P0001_BK_1.jpg）で持ち、
#   表示するときに、この値を頭に付けて絶対URLにする。
#   手元        http://localhost:8000/assets
#   Azure       https://{ストレージ}.blob.core.windows.net
IMAGE_BASE_URL=

# --- 決済代行（IF-01。7.2）-----------------------------------
#   ★ダミーでも本物と同じ経路で読む（7.2.3）。差し替えたときに驚かないため
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- メール送信（7.3）----------------------------------------
MAIL_API_KEY=
MAIL_FROM_ADDRESS=

# --- セッション ----------------------------------------------
SESSION_SECRET=

# --- 定期処理（設計 6.6.0。R-35）-----------------------------
#   バックエンドのプロセスの中でスケジューラを回す。外に別のリソースを置かない。
#   ★1 で回る（既定）。0 にすると立てない。
#   ★試験のときは 0 にする（勝手に動かれると再現できない）
BATCH_SCHEDULER=1
